{
  "rationale": "Plant models robot's perception and motion in a grid, including blue danger area and all obstacle sensors. All events are included and transitions are deterministic. Each state covers all uncontrollables, and at least one controllable is enabled per non-terminal state.",
  "new_states": [
    "clear",
    "obs_front",
    "obs_left",
    "obs_right",
    "blue_area",
    "escape_commit",
    "forward_commit",
    "rotate_commit_cw",
    "rotate_commit_ccw",
    "scan_full",
    "recover_back"
  ],
  "controllable_events": [
    "move_forward",
    "move_backward",
    "rotate_clockwise",
    "rotate_counterclockwise",
    "full_rotate",
    "escape_blue"
  ],
  "uncontrollable_events": [
    "path_clear",
    "obstacle_front",
    "obstacle_left",
    "obstacle_right",
    "blue_detected"
  ],
  "transitions": [
    "(\"clear\", \"path_clear\", \"clear\")",
    "(\"clear\", \"obstacle_front\", \"obs_front\")",
    "(\"clear\", \"obstacle_left\", \"obs_left\")",
    "(\"clear\", \"obstacle_right\", \"obs_right\")",
    "(\"clear\", \"blue_detected\", \"blue_area\")",
    "(\"clear\", \"move_forward\", \"forward_commit\")",
    "(\"clear\", \"rotate_clockwise\", \"rotate_commit_cw\")",
    "(\"clear\", \"full_rotate\", \"scan_full\")",
    "(\"obs_front\", \"path_clear\", \"clear\")",
    "(\"obs_front\", \"obstacle_front\", \"obs_front\")",
    "(\"obs_front\", \"obstacle_left\", \"obs_left\")",
    "(\"obs_front\", \"obstacle_right\", \"obs_right\")",
    "(\"obs_front\", \"blue_detected\", \"blue_area\")",
    "(\"obs_front\", \"move_backward\", \"recover_back\")",
    "(\"obs_front\", \"full_rotate\", \"scan_full\")",
    "(\"obs_left\", \"path_clear\", \"clear\")",
    "(\"obs_left\", \"obstacle_front\", \"obs_front\")",
    "(\"obs_left\", \"obstacle_left\", \"obs_left\")",
    "(\"obs_left\", \"obstacle_right\", \"obs_right\")",
    "(\"obs_left\", \"blue_detected\", \"blue_area\")",
    "(\"obs_left\", \"rotate_clockwise\", \"rotate_commit_cw\")",
    "(\"obs_right\", \"path_clear\", \"clear\")",
    "(\"obs_right\", \"obstacle_front\", \"obs_front\")",
    "(\"obs_right\", \"obstacle_left\", \"obs_left\")",
    "(\"obs_right\", \"obstacle_right\", \"obs_right\")",
    "(\"obs_right\", \"blue_detected\", \"blue_area\")",
    "(\"obs_right\", \"rotate_counterclockwise\", \"rotate_commit_ccw\")",
    "(\"blue_area\", \"path_clear\", \"blue_area\")",
    "(\"blue_area\", \"obstacle_front\", \"blue_area\")",
    "(\"blue_area\", \"obstacle_left\", \"blue_area\")",
    "(\"blue_area\", \"obstacle_right\", \"blue_area\")",
    "(\"blue_area\", \"blue_detected\", \"blue_area\")",
    "(\"blue_area\", \"escape_blue\", \"escape_commit\")",
    "(\"escape_commit\", \"path_clear\", \"clear\")",
    "(\"escape_commit\", \"obstacle_front\", \"obs_front\")",
    "(\"escape_commit\", \"obstacle_left\", \"obs_left\")",
    "(\"escape_commit\", \"obstacle_right\", \"obs_right\")",
    "(\"escape_commit\", \"blue_detected\", \"blue_area\")",
    "(\"forward_commit\", \"path_clear\", \"clear\")",
    "(\"forward_commit\", \"obstacle_front\", \"obs_front\")",
    "(\"forward_commit\", \"obstacle_left\", \"obs_left\")",
    "(\"forward_commit\", \"obstacle_right\", \"obs_right\")",
    "(\"forward_commit\", \"blue_detected\", \"blue_area\")",
    "(\"rotate_commit_cw\", \"path_clear\", \"clear\")",
    "(\"rotate_commit_cw\", \"obstacle_front\", \"obs_front\")",
    "(\"rotate_commit_cw\", \"obstacle_left\", \"obs_left\")",
    "(\"rotate_commit_cw\", \"obstacle_right\", \"obs_right\")",
    "(\"rotate_commit_cw\", \"blue_detected\", \"blue_area\")",
    "(\"rotate_commit_ccw\", \"path_clear\", \"clear\")",
    "(\"rotate_commit_ccw\", \"obstacle_front\", \"obs_front\")",
    "(\"rotate_commit_ccw\", \"obstacle_left\", \"obs_left\")",
    "(\"rotate_commit_ccw\", \"obstacle_right\", \"obs_right\")",
    "(\"rotate_commit_ccw\", \"blue_detected\", \"blue_area\")",
    "(\"scan_full\", \"path_clear\", \"clear\")",
    "(\"scan_full\", \"obstacle_front\", \"obs_front\")",
    "(\"scan_full\", \"obstacle_left\", \"obs_left\")",
    "(\"scan_full\", \"obstacle_right\", \"obs_right\")",
    "(\"scan_full\", \"blue_detected\", \"blue_area\")",
    "(\"recover_back\", \"path_clear\", \"clear\")",
    "(\"recover_back\", \"obstacle_front\", \"obs_front\")",
    "(\"recover_back\", \"obstacle_left\", \"obs_left\")",
    "(\"recover_back\", \"obstacle_right\", \"obs_right\")",
    "(\"recover_back\", \"blue_detected\", \"blue_area\")"
  ]
}
{
  "rationale": "The plant models the robot's perception and motion capabilities, separating sensor outcomes from motion commands. The specification automata enforce safe, efficient exploration: random_walk is preferred in clear states, move_forward is used for short progress, and obstacle events trigger conservative, one-shot recovery turns. Recovery states only allow safe turn actions and return to exploration as soon as the path is clear. Full_rotate is reserved for repeated or dead-end blockages. All transitions are deterministic and cover all uncontrollable events.",
  "strategy": [
    "Separate plant automata for perception and motion: G1 models sensor events, G2 models motion commands.",
    "Specification E1 binds sensor outcomes to allowed actions, enforcing safe, efficient exploration and conservative recovery."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Models the robot's perception: sensor outcomes for front, left, and right obstacles and clear path.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Models the robot's motion subsystem: available controllable actions.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Supervises safe, efficient exploration: enables random_walk in clear, move_forward for short progress, and conservative turn recovery on obstacles. Full_rotate is only used after repeated blockages.",
      "states": [
        "clear",
        "forward_commit",
        "obs_front",
        "recover_cw",
        "recover_ccw",
        "full_scan"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear",
        "forward_commit"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"clear\", \"random_walk\", \"forward_commit\")",
        "(\"clear\", \"obstacle_front\", \"obs_front\")",
        "(\"clear\", \"obstacle_left\", \"recover_cw\")",
        "(\"clear\", \"obstacle_right\", \"recover_ccw\")",
        "(\"clear\", \"path_clear\", \"clear\")",
        "(\"forward_commit\", \"move_forward\", \"clear\")",
        "(\"forward_commit\", \"obstacle_front\", \"obs_front\")",
        "(\"forward_commit\", \"obstacle_left\", \"recover_cw\")",
        "(\"forward_commit\", \"obstacle_right\", \"recover_ccw\")",
        "(\"forward_commit\", \"path_clear\", \"forward_commit\")",
        "(\"obs_front\", \"rotate_clockwise\", \"recover_cw\")",
        "(\"obs_front\", \"obstacle_front\", \"full_scan\")",
        "(\"obs_front\", \"obstacle_left\", \"recover_cw\")",
        "(\"obs_front\", \"obstacle_right\", \"recover_ccw\")",
        "(\"obs_front\", \"path_clear\", \"clear\")",
        "(\"recover_cw\", \"rotate_clockwise\", \"clear\")",
        "(\"recover_cw\", \"obstacle_front\", \"obs_front\")",
        "(\"recover_cw\", \"obstacle_left\", \"recover_cw\")",
        "(\"recover_cw\", \"obstacle_right\", \"recover_ccw\")",
        "(\"recover_cw\", \"path_clear\", \"clear\")",
        "(\"recover_ccw\", \"rotate_counterclockwise\", \"clear\")",
        "(\"recover_ccw\", \"obstacle_front\", \"obs_front\")",
        "(\"recover_ccw\", \"obstacle_left\", \"recover_cw\")",
        "(\"recover_ccw\", \"obstacle_right\", \"recover_ccw\")",
        "(\"recover_ccw\", \"path_clear\", \"clear\")",
        "(\"full_scan\", \"full_rotate\", \"clear\")",

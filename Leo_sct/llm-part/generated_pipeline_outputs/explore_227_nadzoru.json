{
  "rationale": "The plant models the robot's perception and motion capabilities, separating sensing (uncontrollable events) from motion (controllable events). The specification enforces safe, coverage-oriented exploration: random_walk is preferred in clear states, move_forward is used for short progress, and conservative recovery (turns or full_rotate) is used only when obstacles are detected. Recovery states are one-shot and return to exploration as soon as the path is clear.",
  "strategy": [
    "Separate plant automata for sensing and motion to reflect the robot's hardware and runtime semantics.",
    "Specification automaton binds sensor outcomes to safe, progress-maximizing actions, enforcing conservative recovery only when needed and rapid return to exploration."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception: models sensor outcomes as uncontrollable events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot motion: models execution of motion commands as controllable events.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Exploration and safety supervisor: binds sensor outcomes to safe, progress-oriented actions; enforces conservative recovery and rapid return to exploration.",
      "states": [
        "explore_clear",
        "forward_commit",
        "obs_front_recover",
        "obs_left_recover",
        "obs_right_recover"
      ],
      "initial_states": [
        "explore_clear"
      ],
      "marked_states": [
        "explore_clear",
        "forward_commit",
        "obs_front_recover",
        "obs_left_recover",
        "obs_right_recover"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"explore_clear\", \"random_walk\", \"forward_commit\")",
        "(\"explore_clear\", \"obstacle_front\", \"obs_front_recover\")",
        "(\"explore_clear\", \"obstacle_left\", \"obs_left_recover\")",
        "(\"explore_clear\", \"obstacle_right\", \"obs_right_recover\")",
        "(\"explore_clear\", \"path_clear\", \"explore_clear\")",
        "(\"forward_commit\", \"move_forward\", \"explore_clear\")",
        "(\"forward_commit\", \"path_clear\", \"forward_commit\")",
        "(\"forward_commit\", \"obstacle_front\", \"obs_front_recover\")",
        "(\"forward_commit\", \"obstacle_left\", \"obs_left_recover\")",
        "(\"forward_commit\", \"obstacle_right\", \"obs_right_recover\")",
        "(\"obs_front_recover\", \"rotate_clockwise\", \"explore_clear\")",
        "(\"obs_front_recover\", \"path_clear\", \"obs_front_recover\")",
        "(\"obs_front_recover\", \"obstacle_front\", \"obs_front_recover\")",
        "(\"obs_front_recover\", \"obstacle_left\", \"obs_left_recover\")",
        "(\"obs_front_recover\", \"obstacle_right\", \"obs_right_recover\")",
        "(\"obs_left_recover\", \"rotate_clockwise\", \"explore_clear\")",
        "(\"obs_left_recover\", \"path_clear\", \"obs_left_recover\")",
        "(\"obs_left_recover\", \"obstacle_front\", \"obs_front_recover\")",
        "(\"obs_left_recover\", \"obstacle_left\", \"obs_left_recover\")",
        "(\"obs_left_recover\", \"obstacle_right\", \"obs_right_recover\")",
        "(\"obs_right_recover\", \"rotate_counterclockwise\", \"explore_clear\")",
        "(\"obs_right_recover\", \"path_clear\", \"obs_right_recover\")",
        "(\"obs_right_recover\", \"obstacle_front\", \"obs_front_recover\")",
        "(\"obs_right_recover\", \"obstacle_left\", \"obs_left_recover\")",
        "(\"obs_right_recover\", \"obstacle_right\", \"obs_right_recover\")"
      ]
    },
    {
      "name": "E2",
      "purpose": "Prevents repeated random_walk or move_forward actions for better coverage alternation.",
      "states": [
        "ready",
        "after_random_walk",
        "after_move_forward"
      ],
      "initial_states": [
        "ready"
      ],
      "marked_states": [
        "ready",
        "after_random_walk",
        "after_move_forward"
      ],
      "controllable_events": [
        "random_walk",
        "move_forward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"ready\", \"random_walk\", \"after_random_walk\")",
        "(\"ready\", \"move_forward\", \"after_move_forward\")",
        "(\"after_random_walk\", \"move_forward\", \"ready\")",
        "(\"after_move_forward\", \"random_walk\", \"ready\")"
      ]
    }
  ]
}
{
  "rationale": "The plant models robot perception and motion capabilities, separating sensing and actuation. The specification enforces safe, coverage-oriented exploration: random_walk is preferred in clear states, move_forward is used for short progress, and recovery turns are used only when obstacles are detected. Recovery states are one-shot and return to exploration as soon as path_clear is observed. Full_rotate is reserved for persistent blockage. All transitions are deterministic and respect the event and state constraints.",
  "strategy": [
    "Separate plant automata for perception and motion: G1 models sensor outcomes, G2 models motion commands.",
    "Specification E1 binds perception outcomes to allowed actions, enforcing conservative recovery and rapid return to exploration, with random_walk as the primary exploration action in clear states."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Models robot's perception of obstacles via uncontrollable sensor events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Models robot's motion subsystem with controllable movement commands.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Supervisory policy: binds perception to safe, coverage-oriented actions; ensures recovery after obstacles and rapid return to exploration.",
      "states": [
        "clear",
        "forward_commit",
        "obs_front",
        "recover_right",
        "obs_left",
        "obs_right",
        "recover_left",
        "full_scan"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear",
        "forward_commit"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"clear\", \"random_walk\", \"forward_commit\")",
        "(\"clear\", \"obstacle_front\", \"obs_front\")",
        "(\"clear\", \"obstacle_left\", \"obs_left\")",
        "(\"clear\", \"obstacle_right\", \"obs_right\")",
        "(\"clear\", \"path_clear\", \"clear\")",
        "(\"forward_commit\", \"move_forward\", \"clear\")",
        "(\"forward_commit\", \"obstacle_front\", \"obs_front\")",
        "(\"forward_commit\", \"obstacle_left\", \"obs_left\")",
        "(\"forward_commit\", \"obstacle_right\", \"obs_right\")",
        "(\"forward_commit\", \"path_clear\", \"forward_commit\")",
        "(\"obs_front\", \"rotate_clockwise\", \"recover_right\")",
        "(\"obs_front\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_front\", \"obstacle_left\", \"obs_front\")",
        "(\"obs_front\", \"obstacle_right\", \"obs_front\")",
        "(\"obs_front\", \"path_clear\", \"obs_front\")",
        "(\"recover_right\", \"rotate_clockwise\", \"clear\")",
        "(\"recover_right\", \"obstacle_front\", \"full_scan\")",
        "(\"recover_right\", \"obstacle_left\", \"obs_left\")",
        "(\"recover_right\", \"obstacle_right\", \"obs_right\")",
        "(\"recover_right\", \"path_clear\", \"recover_right\")",
        "(\"obs_left\", \"rotate_clockwise\", \"recover_right\")",
        "(\"obs_left\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_left\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_left\", \"obstacle_right\", \"obs_left\")",
        "(\"obs_left\", \"path_clear\", \"obs_left\")",
        "(\"obs_right\", \"rotate_counterclockwise\", \"recover_left\")",
        "(\"obs_right\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_right\", \"obstacle_left\", \"obs_right\")",
        "(\"obs_right\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_right\", \"path_clear\", \"obs_right\")",
        "(\"recover_left\", \"rotate_counterclockwise\", \"clear\")",
        "(\"recover_left\", \"obstacle_front\", \"full_scan\")",
        "(\"recover_left\", \"obstacle_left\", \"obs_left\")",
        "(\"recover_left\", \"obstacle_right\", \"obs_right\")",
        "(\"recover_left\", \"path_clear\", \"recover_left\")",
        "(\"full_scan\", \"full_rotate\", \"clear\")",
        "(\"full_scan\", \"obstacle_front\", \"full_scan\")",
        "(\"full_scan\", \"obstacle_left\", \"full_scan\")",
        "(\"full_scan\", \"obstacle_right\", \"full_scan\")",
        "(\"full_scan\", \"path_clear\", \"full_scan\")"
      ]
    }
  ]
}
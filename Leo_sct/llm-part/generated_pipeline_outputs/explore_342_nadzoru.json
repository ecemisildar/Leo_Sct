{
  "rationale": "The plant models the robot's motion and perception interface, separating motion commands from sensor outcomes. The specification binds sensor outcomes to safe, coverage-oriented actions, enforcing conservative obstacle recovery and rapid return to exploration. Helper states ensure one-shot motion, and recovery states are structured to avoid unsafe actions and oscillations.",
  "strategy": [
    "Separate plant automata for motion and perception: G1 models motion execution, G2 models perception outcomes.",
    "Specification E1 encodes the safe, coverage-oriented supervisor policy, ensuring conservative obstacle recovery and rapid return to exploration, with helper states for one-shot actions and strict event-to-action bindings."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Models the robot's motion execution subsystem, allowing one controllable motion command at a time.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")",
        "(\"idle\", \"move_backward\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Models the robot's perception subsystem, emitting uncontrollable events for obstacle and path status.",
      "states": [
        "sense"

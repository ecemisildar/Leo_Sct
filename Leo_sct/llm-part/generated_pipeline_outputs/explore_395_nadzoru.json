{
  "rationale": "The plant automata model the robot's perception and actuation capabilities, separating sensing (G1) from motion (G2). The specifications (E1-E4) enforce safe, progress-oriented exploration: E1 binds clear perception to forward/random_walk, E2/E3 handle obstacle recovery with directed turns or backward escape, and E4 prevents unsafe or repeated backward/scan actions. The design ensures the robot spends most time exploring, recovers conservatively, and never chains unsafe actions.",
  "strategy": [
    "Separate perception and motion into distinct plant automata for modularity and clarity.",
    "Use specification automata to enforce safe action selection, conservative obstacle recovery, and rapid return to exploration after recovery."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Models the robot's perception of obstacles via uncontrollable sensor events.",
      "states": [
        "percept"
      ],
      "initial_states": [
        "percept"
      ],
      "marked_states": [
        "percept"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"percept\", \"path_clear\", \"percept\")",
        "(\"percept\", \"obstacle_front\", \"percept\")",
        "(\"percept\", \"obstacle_left\", \"percept\")",
        "(\"percept\", \"obstacle_right\", \"percept\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Models the robot's motion actuation; each controllable event is a one-shot pulse.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")",
        "(\"idle\", \"move_backward\", \"idle\")"
      ]
    }
  ],

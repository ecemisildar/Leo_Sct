{
  "rationale": "Use a minimal plant split into sensing and motion capability, then encode the exploration policy in small deterministic specifications. The policy gives random_walk in clear exploration, inserts a short forward pulse after safe wandering to bias coverage, and routes every obstacle observation through a one-shot turn-recovery state. Front obstacles forbid forward/random motion and trigger dedicated recovery; left/right obstacles bias the turn direction away from blocked space. Action states self-loop on non-critical path_clear so open-loop pulses are not preempted, while obstacle events can still interrupt for safety.",
  "strategy": [
    "Separate uncontrollable perception from controllable motion in plant automata",
    "Use one policy specification for clear exploration and dedicated specifications for front/left/right obstacle recovery",
    "Add a small alternation specification so safe exploration alternates random_walk and move_forward instead of long forward streaks",
    "Keep obstacle states one-shot with exactly one controllable action and return quickly to exploration when path_clear occurs"
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception channel for obstacle and path status events",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability for all available robot commands",
      "states": [

{
  "rationale": "The plant models robot motion and perception as separate automata: G1 for motion commands, G2 for sensor outcomes. The specification E1 encodes the safe exploration policy: random_walk is preferred in clear, move_forward is used for short progress, and obstacle events trigger conservative recovery (turns or full scan) before returning to exploration. Recovery states only allow the appropriate turn or scan action and return to exploration as soon as path_clear is observed. All uncontrollables are handled in every state. The design avoids oscillation, infinite controllable loops, and ensures steady coverage.",
  "strategy": [
    "Separate plant automata for motion and perception to allow modular specification.",
    "Specification automaton encodes safe, coverage-biased exploration with conservative recovery and rapid return to exploration after obstacles clear."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion subsystem: executes controllable movement commands.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception subsystem: emits uncontrollable sensor events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Safe, coverage-oriented exploration: random_walk in clear, move_forward for short progress, conservative recovery on obstacles, rapid return to exploration after recovery.",
      "states": [
        "clear",
        "forward_commit",
        "obs_front",
        "obs_left",
        "obs_right",
        "full_scan"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear",
        "forward_commit"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"clear\", \"random_walk\", \"forward_commit\")",
        "(\"clear\", \"obstacle_front\", \"obs_front\")",
        "(\"clear\", \"obstacle_left\", \"obs_left\")",
        "(\"clear\", \"obstacle_right\", \"obs_right\")",
        "(\"clear\", \"path_clear\", \"clear\")",
        "(\"forward_commit\", \"move_forward\", \"clear\")",
        "(\"forward_commit\", \"obstacle_front\", \"obs_front\")",
        "(\"forward_commit\", \"obstacle_left\", \"obs_left\")",
        "(\"forward_commit\", \"obstacle_right\", \"obs_right\")",
        "(\"forward_commit\", \"path_clear\", \"forward_commit\")",
        "(\"obs_front\", \"rotate_clockwise\", \"clear\")",
        "(\"obs_front\", \"path_clear\", \"clear\")",
        "(\"obs_front\", \"obstacle_left\", \"full_scan\")",
        "(\"obs_front\", \"obstacle_right\", \"full_scan\")",
        "(\"obs_front\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_left\", \"rotate_clockwise\", \"clear\")",
        "(\"obs_left\", \"path_clear\", \"clear\")",
        "(\"obs_left\", \"obstacle_front\", \"full_scan\")",
        "(\"obs_left\", \"obstacle_right\", \"full_scan\")",
        "(\"obs_left\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_right\", \"rotate_counterclockwise\", \"clear\")",
        "(\"obs_right\", \"path_clear\", \"clear\")",
        "(\"obs_right\", \"obstacle_front\", \"full_scan\")",
        "(\"obs_right\", \"obstacle_left\", \"full_scan\")",
        "(\"obs_right\", \"obstacle_right\", \"obs_right\")",
        "(\"full_scan\", \"full_rotate\", \"clear\")",
        "(\"full_scan\", \"path_clear\", \"clear\")",
        "(\"full_scan\", \"obstacle_front\", \"full_scan\")",
        "(\"full_scan\", \"obstacle_left\", \"full_scan\")",
        "(\"full_scan\", \"obstacle_right\", \"full_scan\")"
      ]
    }
  ]

{
  "rationale": "The plant models robot motion and perception, separating motion commands from sensor outcomes. The specification enforces safe, coverage-oriented exploration: random_walk is used in clear states, move_forward is used for short progress, and obstacle events trigger conservative, deterministic recovery (turns or full_rotate only as last resort). Recovery states are one-shot and return to exploration as soon as the path is clear. No state enables both rotate directions or both random_walk and move_forward. All uncontrollable events are total in every state.",
  "strategy": [
    "Separate plant automata for motion and perception to reflect open-loop actuation and asynchronous sensing.",
    "Specification automaton binds perception outcomes to safe, progress-oriented actions, enforcing conservative recovery and rapid return to exploration."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion subsystem: executes controllable motion pulses.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception subsystem: reports uncontrollable obstacle and clear events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    }
  ],
  "E": [

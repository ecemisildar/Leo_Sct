{
  "rationale": "The plant models the robot's motion and perception interface, separating motion commands from sensor outcomes. The specification encodes a conservative exploration policy: random_walk is used in clear states for coverage, move_forward is used in a short commit state, and recovery from obstacles is handled by directed turns or, as a last resort, full_rotate. All obstacle events force a recovery turn before returning to exploration, and random_walk is never enabled in obstacle or recovery states. The design avoids oscillations and infinite controllable loops, and always returns to exploration as soon as the path is clear.",
  "strategy": [
    "Separate plant automata for motion and perception to cleanly model controllable and uncontrollable events.",
    "Specification automaton encodes safe, coverage-biased exploration: random_walk in clear/search, move_forward in commit, directed turn recovery, and full_rotate only as last-resort."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion and perception interface: models execution of motion commands and sensor event outcomes.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")",
        "(\"idle\", \"path_clear\", \"idle\")",
        "(\"idle\", \"obstacle_front\", \"idle\")",
        "(\"idle\", \"obstacle_left\", \"idle\")",
        "(\"idle\", \"obstacle_right\", \"idle\")"
      ]
    }
  ],
  "E": [
    {

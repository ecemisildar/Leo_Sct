{
  "rationale": "The plant models the robot's perception and motion primitives as separate automata. The specification encodes a deterministic exploration policy: in clear states, random_walk is preferred for coverage; move_forward is used in a short commit state. Obstacle events force recovery states with safe turns or, as a last resort, a full scan. The supervisor never allows forward or random_walk when an obstacle is detected ahead, and always returns to exploration as soon as the path is clear.",
  "strategy": [
    "Separate perception and motion into distinct plant automata for modularity and clarity.",
    "Specification automaton enforces safe, efficient exploration: random_walk in clear, move_forward in commit, and conservative recovery with minimal full_rotate usage."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception: models uncontrollable sensor events for obstacle detection.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot motion: models controllable motion primitives.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Exploration supervisor: binds perception outcomes to safe, efficient motion actions for coverage and collision avoidance.",
      "states": [
        "clear",
        "forward_commit",
        "obs_front",
        "obs_left",
        "obs_right",
        "recover_full_scan"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"clear\", \"random_walk\", \"forward_commit\")",
        "(\"clear\", \"obstacle_front\", \"obs_front\")",
        "(\"clear\", \"obstacle_left\", \"obs_left\")",
        "(\"clear\", \"obstacle_right\", \"obs_right\")",
        "(\"clear\", \"path_clear\", \"clear\")",
        "(\"forward_commit\", \"move_forward\", \"clear\")",
        "(\"forward_commit\", \"path_clear\", \"forward_commit\")",
        "(\"forward_commit\", \"obstacle_front\", \"obs_front\")",
        "(\"forward_commit\", \"obstacle_left\", \"obs_left\")",
        "(\"forward_commit\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_front\", \"rotate_clockwise\", \"clear\")",
        "(\"obs_front\", \"path_clear\", \"clear\")",
        "(\"obs_front\", \"obstacle_front\", \"recover_full_scan\")",
        "(\"obs_front\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_front\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_left\", \"rotate_clockwise\", \"clear\")",
        "(\"obs_left\", \"path_clear\", \"clear\")",
        "(\"obs_left\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_left\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_left\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_right\", \"rotate_counterclockwise\", \"clear\")",
        "(\"obs_right\", \"path_clear\", \"clear\")",
        "(\"obs_right\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_right\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_right\", \"obstacle_right\", \"obs_right\")",
        "(\"recover_full_scan\", \"full_rotate\", \"clear\")",
        "(\"recover_full_scan\", \"path_clear\", \"clear\")",
        "(\"recover_full_scan\", \"obstacle_front\", \"recover_full_scan\")",

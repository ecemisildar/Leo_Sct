{
  "rationale": "The plant models the robot's perception and actuation capabilities, separating sensing from motion. The specification encodes safe and efficient exploration: random_walk is preferred in clear states, move_forward is used for short progress, and obstacle events trigger conservative, one-shot recovery turns. The supervisor never allows forward or random_walk when an obstacle is present, and always returns to exploration as soon as the path is clear.",
  "strategy": [
    "Separate plant automata for sensing and motion to reflect open-loop actuation and asynchronous sensing.",
    "Specification automaton binds sensor outcomes to safe, progress-oriented actions, enforcing conservative recovery and rapid return to exploration."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion actuator: models all controllable motion commands as one-shot actions.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception: models all possible uncontrollable sensor events.",
      "states": [

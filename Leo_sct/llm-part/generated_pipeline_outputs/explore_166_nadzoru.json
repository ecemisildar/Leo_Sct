{
  "rationale": "The plant models the robot's motion and perception capabilities, separating motion commands from sensor outcomes. The specification encodes a safe, coverage-oriented supervisor: random_walk is preferred in clear states, move_forward is used for short progress, and recovery from obstacles is handled by directed turns or, as a last resort, a full scan. All obstacle recoveries are conservative and deterministic, with no conflicting or oscillatory choices.",
  "strategy": [
    "Separate plant automata for motion and perception to reflect open-loop actuation and asynchronous sensing.",
    "Specification automaton encodes safe, coverage-biased exploration: random_walk in clear, move_forward for progress, deterministic turn recovery for obstacles, and rapid return to exploration after recovery."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion actuator: models execution of controllable motion commands as open-loop pulses.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception: models asynchronous arrival of obstacle and clearance sensor events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Safe, coverage-oriented exploration supervisor: enables random_walk in clear, move_forward for short progress, deterministic turn recovery for obstacles, and rapid return to exploration after recovery.",
      "states": [
        "clear",
        "forward_commit",
        "obs_front",
        "obs_left",
        "obs_right",
        "full_scan"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear",
        "forward_commit"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [

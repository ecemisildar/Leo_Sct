        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot motion: models the robot's actuation capabilities as controllable events.",
      "states": [

        "(\"ready\", \"rotate_clockwise\", \"ready\")",
        "(\"ready\", \"rotate_counterclockwise\", \"ready\")",
        "(\"ready\", \"full_rotate\", \"ready\")",
        "(\"ready\", \"random_walk\", \"ready\")",
        "(\"ready\", \"move_backward\", \"ready\")"
      ]
    }
  ],

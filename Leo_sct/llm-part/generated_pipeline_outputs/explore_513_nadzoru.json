{
  "rationale": "Use a minimal plant split into sensing and motion capability, then encode the exploration/recovery policy in small deterministic specifications. The policy gives strong forward bias in clear space, uses directed turns for side/front obstacles, allows a rare one-step backward escape only after front blockage, and reserves full_rotate for a dedicated repeated-failure last-resort path.",
  "strategy": [
    "Separate uncontrollable perception from controllable motion capability in G",
    "Use one policy specification with helper recovery states so each action state enables exactly one controllable and all uncontrollable events are total",
    "Bias clear-space behavior to move_forward, use random_walk only as a secondary exploration mode after successful forward pulses",
    "Handle obstacle_left with rotate_clockwise and obstacle_right with rotate_counterclockwise consistently",
    "Handle obstacle_front through a dedicated backward escape, then short turn, then immediate return to forward progress when path_clear appears",
    "Reserve full_rotate for a dedicated stuck/last_resort state reached only after repeated blocked conditions"
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant for obstacle and path-clear sensor outcomes",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant exposing all available controllable motion primitives",

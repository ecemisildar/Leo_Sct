{
  "rationale": "The plant models the robot's motion and perception capabilities, separating action commits from sensing. The specification enforces safe exploration: move_forward is only allowed when the path is clear, and any obstacle event forces a right-turn recovery (rotate_clockwise). After recovery, forward progress resumes only when the path is clear. All uncontrollable events are handled in every state, and only one controllable is enabled per state to ensure determinism and avoid oscillation.",
  "strategy": [
    "Separate plant automata for motion and perception to clarify event sources and action commits.",
    "Specification automaton binds perception outcomes to allowed actions, enforcing always-turn-right recovery and forward progress when safe."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion subsystem: executes move_forward and rotate_clockwise commands as open-loop pulses.",
      "states": [
        "idle",
        "forward_commit",
        "rotate_commit_cw"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"forward_commit\")",
        "(\"idle\", \"rotate_clockwise\", \"rotate_commit_cw\")",
        "(\"forward_commit\", \"move_forward\", \"forward_commit\")",
        "(\"forward_commit\", \"rotate_clockwise\", \"forward_commit\")",
        "(\"forward_commit\", \"idle\", \"idle\")",
        "(\"rotate_commit_cw\", \"move_forward\", \"rotate_commit_cw\")",
        "(\"rotate_commit_cw\", \"rotate_clockwise\", \"rotate_commit_cw\")",
        "(\"rotate_commit_cw\", \"idle\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception: models uncontrollable sensor events for front, left, right obstacles and clear path.",

        "(\"clear_search\", \"obstacle_left\", \"left_recover\")",
        "(\"clear_search\", \"obstacle_right\", \"right_recover\")",
        "(\"clear_search\", \"random_walk\", \"forward_step\")",
        "(\"forward_step\", \"path_clear\", \"forward_step\")",

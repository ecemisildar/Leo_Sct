      ],
      "marked_states": [
        "clear_search",
        "forward_step",
        "front_recover",
        "left_recover",
        "right_recover"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",

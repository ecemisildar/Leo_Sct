{
  "rationale": "Use a small sensor plant plus a motion-capability plant, then encode the exploration policy in deterministic specifications with one-shot action states. Clear sensing drives random-walk exploration first, then a short forward pulse, while any obstacle forces a turn-recovery state. Action states self-loop on path_clear so intended pulses are not preempted, but safety-critical obstacle events can redirect to recovery. Full rotate is omitted because ordinary short turns are sufficient and preferred for coverage.",
  "strategy": [
    "Separate sensing and actuation into plant automata and place policy in specifications",
    "Use deterministic one-shot explore and recovery states: clear -> random_walk -> forward -> clear, with obstacle-triggered turn recovery and fast return to exploration"
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Obstacle sensing channel producing uncontrollable perception events",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant allowing any available motion pulse command",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1_policy",
      "purpose": "Main exploration and obstacle-recovery policy with deterministic one-shot action states",
      "states": [
        "clear_search",
        "forward_step",
        "front_recover",
        "left_recover",
        "right_recover"
      ],
      "initial_states": [

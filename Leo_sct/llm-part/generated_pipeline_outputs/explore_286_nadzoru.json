        "(\"recover_front_cw\", \"obstacle_right\", \"recover_right_ccw\")",
        "(\"recover_front_cw\", \"rotate_clockwise\", \"explore_clear\")",
        "(\"recover_left_cw\", \"path_clear\", \"recover_left_cw\")",
        "(\"recover_left_cw\", \"obstacle_front\", \"recover_front_cw\")",

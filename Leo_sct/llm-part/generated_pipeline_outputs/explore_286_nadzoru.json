        "(\"scan_escape\", \"obstacle_left\", \"recover_left_cw\")",
        "(\"scan_escape\", \"obstacle_right\", \"recover_right_ccw\")",
        "(\"scan_escape\", \"full_rotate\", \"explore_clear\")"
      ]
    },
    {

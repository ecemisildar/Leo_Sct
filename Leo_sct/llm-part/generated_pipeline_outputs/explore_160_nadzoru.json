{
  "rationale": "The plant models the robot's perception and actuation capabilities, separating sensing from motion. The specification encodes a safe, coverage-oriented supervisor: it enables random_walk in clear states, short forward progress when clear, and conservative turn-based recovery when obstacles are detected. Obstacle events preempt unsafe actions, and recovery states use only a single turn or scan action before returning to exploration. All uncontrollable events are handled deterministically and conservatively.",
  "strategy": [
    "Separate plant automata for sensing and motion: G1 models perception, G2 models motion.",
    "Specification E1 binds perception outcomes to safe, progress-oriented actions, enforcing conservative recovery and steady exploration."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Models robot's perception: reports uncontrollable obstacle and path-clear events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Models robot's motion: executes controllable movement commands.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Supervisory specification: ensures safe, coverage-oriented exploration with conservative obstacle recovery and steady progress.",
      "states": [
        "clear",
        "forward_commit",
        "search",
        "obs_front",
        "recover_cw",
        "obs_left",
        "obs_right",
        "recover_ccw",
        "scan_full"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear",
        "search"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",

{
  "rationale": "Use a small sensor plant plus a motion-capability plant, then encode the exploration policy in one readable deterministic specification. The specification separates perception states from one-shot recovery/commit states so obstacle events are handled conservatively, forward motion is never enabled under front-obstacle conditions, side obstacles trigger consistent turns away from the obstacle, and clear conditions quickly return to exploration with random_walk as the default coverage action.",
  "strategy": [
    "Model sensing and actuation as separate plants with only the provided events",
    "Use one deterministic policy specification with total uncontrollable transitions, one controllable per non-terminal state, obstacle-only recovery states, and quick return to clear exploration"
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Local obstacle sensing channel producing uncontrollable perception events",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot motion capability for open-loop pulse actions and scan action",
      "states": [

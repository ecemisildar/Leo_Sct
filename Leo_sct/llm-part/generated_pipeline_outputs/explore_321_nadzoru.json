        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"motion\", \"move_forward\", \"motion\")",
        "(\"motion\", \"rotate_clockwise\", \"motion\")",
        "(\"motion\", \"rotate_counterclockwise\", \"motion\")",
        "(\"motion\", \"full_rotate\", \"motion\")",
        "(\"motion\", \"random_walk\", \"motion\")",
        "(\"motion\", \"move_backward\", \"motion\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Safe exploration policy: random-walk by default in clear space, short forward progress after clear confirmation, backward escape for front obstacles, and consistent turns away from side obstacles",
      "states": [
        "clear_search",
        "forward_step",
        "front_recover_back",
        "left_recover_turn",
        "right_recover_turn"
      ],
      "initial_states": [

{
  "rationale": "The plant models the robot's perception and actuation capabilities, separating sensor outcomes from motion commands. The specification encodes a safe, always-turn-right exploration policy: move forward when clear, rotate clockwise to recover from any obstacle, and only return to forward progress after the path is clear. All obstacle events preempt forward motion and force a right turn recovery. The design is deterministic, safe, and maximizes spatial progress.",
  "strategy": [
    "Separate plant automata for perception and motion: one for sensors, one for actuation.",
    "Specification automaton binds perception outcomes to safe actions, enforcing always-turn-right recovery and forward progress when clear."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception: models uncontrollable sensor events for front, left, right obstacles and path clearance.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot actuation: models controllable motion commands (move_forward, rotate_clockwise).",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Safe exploration supervisor: enables move_forward only when clear, rotate_clockwise as the only recovery, always-turn-right policy, and ensures deterministic, progress-maximizing behavior.",
      "states": [
        "clear",
        "obs_front",
        "obs_left",
        "obs_right",
        "rotate_commit"
      ],

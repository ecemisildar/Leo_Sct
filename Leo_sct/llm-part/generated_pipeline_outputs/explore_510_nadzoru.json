{
  "rationale": "Use a small sensor plant plus a motion-command plant, then layer compact specifications that map sensed obstacle conditions to exactly one safe recovery action. Forward motion is the default in clear conditions, random_walk is allowed only as a secondary clear-space exploration bias, obstacle states never allow forward/random_walk, move_backward is used only in dedicated front-obstacle recovery, and full_rotate is reserved for a dedicated last-resort stuck state after repeated front blockage.",
  "strategy": [
    "Separate sensing and actuation into plant automata so specifications can enforce perception-to-action bindings cleanly.",
    "Use one-shot recovery states: front obstacle triggers brief backward escape then directed turn; side obstacles trigger consistent directed turns; repeated front blockage escalates to a dedicated full_rotate last-resort state."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant for obstacle observations",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for all available robot commands",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")",
        "(\"idle\", \"move_backward\", \"idle\")"
      ]
    }
  ],
  "E": [

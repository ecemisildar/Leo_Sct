        "(\"monitor\", \"obstacle_front\", \"monitor\")",
        "(\"monitor\", \"obstacle_left\", \"monitor\")",
        "(\"monitor\", \"obstacle_right\", \"monitor\")",
        "(\"clear_ready\", \"path_clear\", \"clear_ready\")",
        "(\"clear_ready\", \"obstacle_front\", \"monitor\")",
        "(\"clear_ready\", \"obstacle_left\", \"monitor\")",
        "(\"clear_ready\", \"obstacle_right\", \"monitor\")",
        "(\"clear_ready\", \"move_forward\", \"monitor\")"
      ]
    },

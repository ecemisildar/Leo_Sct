{
  "rationale": "The plant models the robot's perception and actuation capabilities, separating sensing (uncontrollable events) from motion (controllable events). The specification enforces safe, coverage-oriented exploration: random_walk is preferred in clear states, move_forward is used for short progress, and obstacle events trigger conservative, one-shot recovery turns. Recovery states only allow the appropriate turn, and return to exploration as soon as the path is clear. full_rotate is reserved for deliberate scans after repeated obstacles, not as a first response.",
  "strategy": [
    "Separate plant automata for sensing and motion to reflect the robot's hardware interface.",
    "Specification automaton encodes the exploration policy: random_walk in clear, move_forward for progress, single-action recovery for obstacles, and quick return to exploration after recovery."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception: models the robot's sensor outcomes for front, left, and right obstacles, and path clearance.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot actuation: models the robot's motion commands as open-loop pulses.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Exploration supervisor: binds sensor outcomes to safe, coverage-oriented actions with conservative recovery and quick return to exploration.",
      "states": [
        "clear",
        "forward_commit",
        "obs_front",
        "obs_left",
        "obs_right",
        "rotate_commit_cw",
        "rotate_commit_ccw",
        "scan_full"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [
        "clear"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"clear\", \"path_clear\", \"clear\")",
        "(\"clear\", \"obstacle_front\", \"obs_front\")",
        "(\"clear\", \"obstacle_left\", \"obs_left\")",
        "(\"clear\", \"obstacle_right\", \"obs_right\")",
        "(\"clear\", \"random_walk\", \"forward_commit\")",
        "(\"forward_commit\", \"path_clear\", \"forward_commit\")",
        "(\"forward_commit\", \"obstacle_front\", \"obs_front\")",
        "(\"forward_commit\", \"obstacle_left\", \"obs_left\")",
        "(\"forward_commit\", \"obstacle_right\", \"obs_right\")",
        "(\"forward_commit\", \"move_forward\", \"clear\")",
        "(\"obs_front\", \"path_clear\", \"obs_front\")",
        "(\"obs_front\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_front\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_front\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_front\", \"rotate_clockwise\", \"rotate_commit_cw\")",
        "(\"obs_left\", \"path_clear\", \"obs_left\")",
        "(\"obs_left\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_left\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_left\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_left\", \"rotate_clockwise\", \"rotate_commit_cw\")",
        "(\"obs_right\", \"path_clear\", \"obs_right\")",
        "(\"obs_right\", \"obstacle_front\", \"obs_front\")",
        "(\"obs_right\", \"obstacle_left\", \"obs_left\")",
        "(\"obs_right\", \"obstacle_right\", \"obs_right\")",
        "(\"obs_right\", \"rotate_counterclockwise\", \"rotate_commit_ccw\")",
        "(\"rotate_commit_cw\", \"path_clear\", \"rotate_commit_cw\")",
        "(\"rotate_commit_cw\", \"obstacle_front\", \"obs_front\")",
        "(\"rotate_commit_cw\", \"obstacle_left\", \"obs_left\")",
        "(\"rotate_commit_cw\", \"obstacle_right\", \"obs_right\")",
        "(\"rotate_commit_cw\", \"rotate_clockwise\", \"clear\")",
        "(\"rotate_commit_ccw\", \"path_clear\", \"rotate_commit_ccw\")",
        "(\"rotate_commit_ccw\", \"obstacle_front\", \"obs_front\")",
        "(\"rotate_commit_ccw\", \"obstacle_left\", \"obs_left\")",
        "(\"rotate_commit_ccw\", \"obstacle_right\", \"obs_right\")",
        "(\"rotate_commit_ccw\", \"rotate_counterclockwise\", \"clear\")",
        "(\"scan_full\", \"path_clear\", \"scan_full\")",
        "(\"scan_full\", \"obstacle_front\", \"obs_front\")",
        "(\"scan_full\", \"obstacle_left\", \"obs_left\")",
        "(\"scan_full\", \"obstacle_right\", \"obs_right\")",
        "(\"scan_full\", \"full_rotate\", \"clear\")"
      ]
    }
  ]
}
{
  "rationale": "The plant is split into sensing and motion capability so the supervisor can react to uncontrollable obstacle observations before issuing one-shot motion pulses. The specifications encode a conservative but coverage-biased policy: random_walk is the default in clear exploration, short forward progress is used after clear confirmation, obstacle events force dedicated turn recovery, and path_clear returns quickly to exploration.",
  "strategy": [
    "Model perception as an always-enabled uncontrollable plant and motion as an always-enabled controllable plant",
    "Use small deterministic specifications: one for exploration alternation, one for front-obstacle recovery, one for left/right directional recovery, and one to keep full_rotate only as a last-resort blocked escape"
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Obstacle sensing channel producing uncontrollable environment observations",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for one-shot open-loop motion commands",
      "states": [
        "ready"
      ],
      "initial_states": [
        "ready"
      ],
      "marked_states": [
        "ready"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"ready\", \"move_forward\", \"ready\")",
        "(\"ready\", \"rotate_clockwise\", \"ready\")",
        "(\"ready\", \"rotate_counterclockwise\", \"ready\")",
        "(\"ready\", \"full_rotate\", \"ready\")",
        "(\"ready\", \"random_walk\", \"ready\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Main exploration policy: default random_walk in clear/search, then short forward progress after clear confirmation; obstacle events route to dedicated recovery states",
      "states": [

        "(\"explore_clear\", \"obstacle_left\", \"recover_left\")",
        "(\"explore_clear\", \"obstacle_right\", \"recover_right\")",
        "(\"explore_clear\", \"random_walk\", \"explore_clear\")",
        "(\"forward_progress\", \"path_clear\", \"forward_progress\")",

{
  "rationale": "The plant automata model the robot's motion capabilities and sensor outcomes. The specification automata enforce safe, efficient exploration: random_walk is used in clear/search states for coverage, move_forward is used for short progress, and obstacle events force conservative recovery with directed turns or, as a last resort, a full scan. The design ensures determinism, avoids oscillations, and always enables a controllable action in non-terminal states.",
  "strategy": [
    "Separate plant automata for motion commands and sensor outcomes to reflect the robot's actuation and perception subsystems.",
    "Specification automata bind sensor outcomes to safe, progress-oriented actions, enforcing conservative recovery and rapid return to exploration after obstacles."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion subsystem: models execution of controllable motion commands as open-loop pulses.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception subsystem: models sensor outcomes for obstacle and path-clear detection.",
      "states": [

{
  "rationale": "Use a minimal plant split into sensing and motion capability, then encode the exploration policy in one readable deterministic specification. The specification gives exactly one controllable action in each non-terminal decision state, keeps all uncontrollable events defined at every state, blocks forward/random motion in obstacle-recovery states, prefers random exploration in clear space, uses short directed turns for ordinary recovery, and returns quickly to exploration when path_clear is observed.",
  "strategy": [
    "Model sensing outcomes as always-available uncontrollable events and motion commands as always-available controllable events in separate plant automata.",
    "Use a single deterministic supervisor specification with small helper commit/recovery states so obstacle events are handled conservatively while clear-space behavior strongly favors coverage."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant for obstacle and clear sensor outcomes",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for available robot action pulses",
      "states": [
        "motion"
      ],
      "initial_states": [
        "motion"
      ],
      "marked_states": [
        "motion"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"motion\", \"move_forward\", \"motion\")",
        "(\"motion\", \"rotate_clockwise\", \"motion\")",
        "(\"motion\", \"rotate_counterclockwise\", \"motion\")",
        "(\"motion\", \"full_rotate\", \"motion\")",
        "(\"motion\", \"random_walk\", \"motion\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Safe exploration policy with strong coverage bias, directed obstacle recovery, and one-shot motion commits",
      "states": [
        "clear_search",
        "forward_progress",
        "front_recover_cw",
        "left_recover_cw",
        "right_recover_ccw",
        "scan_recover"
      ],
      "initial_states": [
        "clear_search"
      ],
      "marked_states": [
        "clear_search",
        "forward_progress",
        "front_recover_cw",
        "left_recover_cw",
        "right_recover_ccw",
        "scan_recover"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"clear_search\", \"path_clear\", \"clear_search\")",
        "(\"clear_search\", \"obstacle_front\", \"front_recover_cw\")",
        "(\"clear_search\", \"obstacle_left\", \"left_recover_cw\")",
        "(\"clear_search\", \"obstacle_right\", \"right_recover_ccw\")",
        "(\"clear_search\", \"random_walk\", \"forward_progress\")",

        "(\"forward_progress\", \"obstacle_left\", \"left_recover_cw\")",
        "(\"forward_progress\", \"obstacle_right\", \"right_recover_ccw\")",
        "(\"forward_progress\", \"move_forward\", \"clear_search\")",
        "(\"front_recover_cw\", \"path_clear\", \"front_recover_cw\")",

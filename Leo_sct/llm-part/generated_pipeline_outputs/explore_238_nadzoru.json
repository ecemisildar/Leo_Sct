{
  "rationale": "The plant models the robot's perception and motion capabilities, separating sensing (uncontrollable) from motion (controllable). The specification enforces safe, coverage-oriented exploration: random_walk is preferred in clear states, move_forward is used for short progress, and recovery turns are triggered by obstacles. Recovery uses rotate_clockwise for front/left obstacles and rotate_counterclockwise for right obstacles, with full_rotate reserved for repeated blocks. The supervisor always returns to exploration as soon as the path is clear.",
  "strategy": [
    "Separate plant automata for sensing and motion to reflect open-loop actuation and asynchronous sensing.",
    "Specification automaton binds sensor outcomes to safe, progress-oriented actions, enforcing conservative recovery and rapid return to exploration."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception: models sensor outcomes for obstacles and clear path.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot motion: models execution of motion commands as open-loop pulses.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Supervisory policy: ensures safe, coverage-biased exploration with conservative recovery and rapid return to exploration.",
      "states": [
        "explore_clear",
        "forward_commit",
        "recover_front",
        "recover_left",
        "recover_right",
        "scan_full"
      ],
      "initial_states": [
        "explore_clear"
      ],
      "marked_states": [
        "explore_clear",
        "forward_commit"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"explore_clear\", \"path_clear\", \"explore_clear\")",
        "(\"explore_clear\", \"obstacle_front\", \"recover_front\")",
        "(\"explore_clear\", \"obstacle_left\", \"recover_left\")",
        "(\"explore_clear\", \"obstacle_right\", \"recover_right\")",
        "(\"explore_clear\", \"random_walk\", \"forward_commit\")",
        "(\"forward_commit\", \"path_clear\", \"explore_clear\")",
        "(\"forward_commit\", \"obstacle_front\", \"recover_front\")",
        "(\"forward_commit\", \"obstacle_left\", \"recover_left\")",
        "(\"forward_commit\", \"obstacle_right\", \"recover_right\")",
        "(\"forward_commit\", \"move_forward\", \"explore_clear\")",
        "(\"recover_front\", \"path_clear\", \"explore_clear\")",
        "(\"recover_front\", \"obstacle_front\", \"scan_full\")",
        "(\"recover_front\", \"obstacle_left\", \"recover_left\")",
        "(\"recover_front\", \"obstacle_right\", \"recover_right\")",
        "(\"recover_front\", \"rotate_clockwise\", \"explore_clear\")",
        "(\"recover_left\", \"path_clear\", \"explore_clear\")",
        "(\"recover_left\", \"obstacle_front\", \"recover_front\")",
        "(\"recover_left\", \"obstacle_left\", \"scan_full\")",
        "(\"recover_left\", \"obstacle_right\", \"recover_right\")",
        "(\"recover_left\", \"rotate_clockwise\", \"explore_clear\")",
        "(\"recover_right\", \"path_clear\", \"explore_clear\")",
        "(\"recover_right\", \"obstacle_front\", \"recover_front\")",
        "(\"recover_right\", \"obstacle_left\", \"recover_left\")",
        "(\"recover_right\", \"obstacle_right\", \"scan_full\")",
        "(\"recover_right\", \"rotate_counterclockwise\", \"explore_clear\")",
        "(\"scan_full\", \"path_clear\", \"explore_clear\")",
        "(\"scan_full\", \"obstacle_front\", \"scan_full\")",
        "(\"scan_full\", \"obstacle_left\", \"scan_full\")",
        "(\"scan_full\", \"obstacle_right\", \"scan_full\")",
        "(\"scan_full\", \"full_rotate\", \"explore_clear\")"
      ]
    }
  ]
}
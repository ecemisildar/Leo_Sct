      ],
      "marked_states": [
        "motion"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"motion\", \"move_forward\", \"motion\")",
        "(\"motion\", \"rotate_clockwise\", \"motion\")",
        "(\"motion\", \"rotate_counterclockwise\", \"motion\")",
        "(\"motion\", \"full_rotate\", \"motion\")",
        "(\"motion\", \"random_walk\", \"motion\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Exploration and obstacle-avoidance supervisor with explicit recovery and quick return to exploration",
      "states": [
        "clear_explore",
        "forward_step",
        "recover_front",
        "recover_left",
        "recover_right"
      ],
      "initial_states": [

{
  "rationale": "The plant models the robot's motion and perception capabilities, separating motion commands from sensor outcomes. The specification enforces safe, conservative exploration: random_walk is used in clear states for coverage, move_forward is used only in a short commit state, and obstacle events force recovery via directed turns or, as a last resort, a full scan. Recovery states are one-shot and return to exploration as soon as the path is clear.",
  "strategy": [
    "Separate plant automata for motion and perception to reflect open-loop actuation and asynchronous sensing.",
    "Specification automaton binds sensor outcomes to safe actions, ensuring obstacle avoidance and steady exploration with minimal recovery overhead."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion subsystem: executes controllable motion commands as open-loop pulses.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot perception subsystem: models uncontrollable sensor outcomes for obstacle detection.",
      "states": [
        "clear",
        "obs_front",
        "obs_left",
        "obs_right"
      ],
      "initial_states": [
        "clear"
      ],
      "marked_states": [

{
  "rationale": "The plant models the robot's perception and actuation capabilities, separating sensing (obstacle events) from motion commands. The specification automata enforce safe, coverage-oriented exploration: random_walk is used in clear/search states, move_forward is used only in short forward-commit states, and conservative turn/scan recovery is used after obstacle events. Recovery states are one-shot and only enable a single turn or scan action, returning to exploration as soon as the path is clear. All uncontrollable events are handled deterministically and safely.",
  "strategy": [
    "Separate plant automata for perception and motion to allow modular specification control.",
    "Specification automata bind sensor outcomes to safe, progress-maximizing actions, enforcing conservative recovery and rapid return to exploration."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception: models uncontrollable obstacle and path_clear events.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Robot motion: models controllable motion commands.",
      "states": [

{
  "rationale": "Use a small plant split into sensing and motion capability, then encode the exploration policy in specifications. The policy gives priority to forward progress in clear conditions, uses short directed turns for side/front obstacles, allows a rare one-shot backward escape only from a dedicated front-obstacle recovery state, and reserves full_rotate for a dedicated last-resort stuck state after repeated front blockage. Action states are one-shot, and uncontrollable events are total in every specification state.",
  "strategy": [
    "Separate sensor outcomes from motion capabilities in G so E can enforce safe perception-to-action bindings.",
    "Use decision and one-shot recovery states in E to bias strongly toward move_forward/random_walk in clear space while keeping obstacle handling brief and safety-oriented."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant for local obstacle observations",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for all available robot commands",
      "states": [
        "motion"
      ],
      "initial_states": [
        "motion"
      ],
      "marked_states": [
        "motion"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"motion\", \"move_forward\", \"motion\")",
        "(\"motion\", \"rotate_clockwise\", \"motion\")",
        "(\"motion\", \"rotate_counterclockwise\", \"motion\")",
        "(\"motion\", \"full_rotate\", \"motion\")",
        "(\"motion\", \"random_walk\", \"motion\")",
        "(\"motion\", \"move_backward\", \"motion\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1_exploration_policy",
      "purpose": "Main exploration and obstacle-recovery policy with strong forward-progress bias and brief one-shot recoveries",
      "states": [
        "monitor",
        "clear_fwd",
        "clear_rw",
        "left_recover",
        "right_recover",
        "front_back",
        "front_turn",
        "stuck",
        "last_resort_scan"
      ],
      "initial_states": [
        "monitor"
      ],
      "marked_states": [
        "monitor",
        "clear_fwd",
        "clear_rw",
        "left_recover",
        "right_recover",
        "front_back",
        "front_turn",
        "stuck",
        "last_resort_scan"
      ],
      "controllable_events": [
        "move_forward",
        "random_walk",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "move_backward",
        "full_rotate"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"monitor\", \"path_clear\", \"clear_fwd\")",
        "(\"monitor\", \"obstacle_front\", \"front_back\")",
        "(\"monitor\", \"obstacle_left\", \"left_recover\")",
        "(\"monitor\", \"obstacle_right\", \"right_recover\")",
        "(\"clear_fwd\", \"move_forward\", \"clear_rw\")",

{
  "rationale": "The plant models the robot's perception and motion capabilities, separating sensor outcomes from motion commands. The specification encodes a conservative exploration policy: random_walk is used for coverage in clear states, move_forward is used for short progress, and recovery turns are chosen deterministically based on obstacle direction. Full_rotate is reserved for deadlock recovery. All obstacle events force a recovery turn before returning to exploration. The design avoids oscillations and ensures safety by never enabling forward or random_walk in obstacle states.",
  "strategy": [
    "Separate plant automata for perception and motion; all events are modeled as atomic pulses.",
    "Specification automaton encodes safe, deterministic exploration: random_walk in clear, move_forward in short bursts, deterministic turn recovery, and full_rotate only for deadlock."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot perception and motion event plant: models all sensor outcomes and motion commands as atomic events.",
      "states": [
        "idle"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"idle\", \"move_forward\", \"idle\")",
        "(\"idle\", \"rotate_clockwise\", \"idle\")",
        "(\"idle\", \"rotate_counterclockwise\", \"idle\")",
        "(\"idle\", \"full_rotate\", \"idle\")",
        "(\"idle\", \"random_walk\", \"idle\")",
        "(\"idle\", \"path_clear\", \"idle\")",
        "(\"idle\", \"obstacle_front\", \"idle\")",
        "(\"idle\", \"obstacle_left\", \"idle\")",
        "(\"idle\", \"obstacle_right\", \"idle\")"
      ]
    }
  ],

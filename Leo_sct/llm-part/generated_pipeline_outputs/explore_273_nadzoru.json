        "(\"recover_ccw_right\", \"obstacle_left\", \"recover_ccw_right\")",
        "(\"recover_ccw_right\", \"obstacle_right\", \"recover_ccw_right\")",
        "(\"recover_ccw_right\", \"rotate_counterclockwise\", \"clear_search\")"
      ]
    }
  ]
}
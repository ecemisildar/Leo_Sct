{
  "rationale": "Use a minimal sensor plant plus a motion-command plant, then a small set of deterministic specifications that map sensed obstacle conditions to one-shot exploration or recovery actions. Clear states favor random_walk and alternate with short move_forward progress, while obstacle states force directed turns and return quickly to exploration when path_clear is observed.",
  "strategy": [
    "Separate uncontrollable perception from controllable motion capability",
    "Encode safe exploration with small one-shot action states and obstacle-specific recovery states"
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant for obstacle observations",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for available robot commands",
      "states": [
        "ready"
      ],
      "initial_states": [
        "ready"
      ],
      "marked_states": [
        "ready"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"ready\", \"move_forward\", \"ready\")",
        "(\"ready\", \"rotate_clockwise\", \"ready\")",
        "(\"ready\", \"rotate_counterclockwise\", \"ready\")",
        "(\"ready\", \"full_rotate\", \"ready\")",
        "(\"ready\", \"random_walk\", \"ready\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Main exploration and obstacle-recovery policy",
      "states": [
        "explore_clear",
        "forward_step",
        "recover_front",
        "recover_left",
        "recover_right"
      ],
      "initial_states": [
        "explore_clear"
      ],
      "marked_states": [
        "explore_clear",
        "forward_step",
        "recover_front",
        "recover_left",
        "recover_right"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"explore_clear\", \"path_clear\", \"explore_clear\")",
        "(\"explore_clear\", \"obstacle_front\", \"recover_front\")",
        "(\"explore_clear\", \"obstacle_left\", \"recover_left\")",
        "(\"explore_clear\", \"obstacle_right\", \"recover_right\")",
        "(\"explore_clear\", \"random_walk\", \"forward_step\")",
        "(\"forward_step\", \"path_clear\", \"forward_step\")",
        "(\"forward_step\", \"obstacle_front\", \"recover_front\")",
        "(\"forward_step\", \"obstacle_left\", \"recover_left\")",
        "(\"forward_step\", \"obstacle_right\", \"recover_right\")",
        "(\"forward_step\", \"move_forward\", \"explore_clear\")",

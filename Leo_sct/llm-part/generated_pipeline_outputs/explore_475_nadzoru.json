{
  "rationale": "Use a small plant split into sensing and motion capability, then encode the exploration policy in compact deterministic specifications. The policy gives forward motion in clear conditions, uses short directed turns for side/front obstacles, allows a rare one-shot backward escape only from a dedicated front-obstacle recovery state, and reserves full_rotate for a dedicated last-resort stuck state after repeated front blockage. Action states are one-shot, and uncontrollable events are total in every specification state.",
  "strategy": [
    "Separate environment sensing from motion capability in G so E can enforce safe perception-to-action bindings.",
    "Bias toward coverage by making clear conditions lead to move_forward, using brief directed recovery for obstacles, and returning to forward exploration immediately when path_clear is observed."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Local obstacle sensing outcomes available to the supervisor",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {

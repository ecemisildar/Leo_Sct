        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for one-shot open-loop motion pulses",
      "states": [

{
  "rationale": "The plant models the robot's motion and perception capabilities, separating motion commands from sensor outcomes. The specification enforces strict safety: obstacle events preempt motion, recovery turns are explicit and unambiguous, and exploration alternates between random_walk and short forward pulses. Obstacle recovery always passes through a dedicated turn state, with turn direction biased away from the blocked side. Exploration resumes only when the path is clear.",
  "strategy": [
    "Separate plant automata for motion and perception to reflect open-loop actuation and asynchronous sensing.",
    "Specification automaton encodes conservative exploration: random_walk in clear, move_forward only in a commit state, explicit turn-based recovery for obstacles, and no ambiguous or unsafe transitions."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Robot motion subsystem: executes controllable actions as open-loop pulses.",
      "states": [
        "idle",
        "forward_commit",
        "rotate_commit_cw",
        "rotate_commit_ccw",
        "random_walk_commit"
      ],
      "initial_states": [
        "idle"
      ],
      "marked_states": [
        "idle"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"idle\", \"move_forward\", \"forward_commit\")",
        "(\"idle\", \"rotate_clockwise\", \"rotate_commit_cw\")",
        "(\"idle\", \"rotate_counterclockwise\", \"rotate_commit_ccw\")",
        "(\"idle\", \"random_walk\", \"random_walk_commit\")",
        "(\"forward_commit\", \"move_forward\", \"idle\")",
        "(\"rotate_commit_cw\", \"rotate_clockwise\", \"idle\")",
        "(\"rotate_commit_ccw\", \"rotate_counterclockwise\", \"idle\")",
        "(\"random_walk_commit\", \"random_walk\", \"idle\")"
      ]
    },

        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"ready\", \"move_forward\", \"ready\")",
        "(\"ready\", \"rotate_clockwise\", \"ready\")",
        "(\"ready\", \"rotate_counterclockwise\", \"ready\")",
        "(\"ready\", \"full_rotate\", \"ready\")",
        "(\"ready\", \"random_walk\", \"ready\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1",
      "purpose": "Exploration and obstacle-avoidance supervisor: random exploration when clear, short forward progress when still clear, and explicit directed turn recovery after obstacles",
      "states": [

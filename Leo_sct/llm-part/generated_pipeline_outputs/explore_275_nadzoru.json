{
  "rationale": "Use a minimal plant that exposes all sensing and motion events, then a compact policy specification with clear exploration and one-shot recovery states. The specification enforces: random_walk in clear exploration, explicit directed turn recovery after any obstacle, no forward/random motion in obstacle-reached states, right-turn bias for obstacle_left, left-turn bias for obstacle_right, and quick return to exploration on path_clear while keeping obstacle events safety-critical in commit states.",
  "strategy": [
    "Model sensing and actuation separately in the plant: one sensor plant for uncontrollable obstacle outcomes and one motion plant for controllable motion primitives.",
    "Use a single compact supervisor specification with meaningful states: clear exploration, short forward progress, and three dedicated turn-recovery states.",
    "Make action states one-shot: each enabled controllable leaves the state immediately to a perception/exploration state.",
    "In action/recovery states, self-loop path_clear so the intended pulse is not preempted, but let obstacle events redirect to the appropriate safety recovery state.",
    "Bias away from blocked sides consistently: obstacle_left -> clockwise recovery, obstacle_right -> counterclockwise recovery, obstacle_front -> explicit clockwise recovery."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant generating uncontrollable obstacle and clear events from sensors",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],

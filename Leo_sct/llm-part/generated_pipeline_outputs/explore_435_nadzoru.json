{
  "rationale": "The design separates sensing availability from motion capability in the plant and uses compact specifications to map each sensed condition to exactly one safe motion choice. Clear conditions bias strongly toward forward progress via move_forward, while obstacle conditions force a one-shot recovery state before exploration resumes. Because uncontrollable events are processed before controllable actions and motion pulses are open-loop, obstacle-triggered recovery states disable forward/random_walk and use conservative directed turns or a brief backward escape only for front obstacles. path_clear in recovery returns quickly to forward exploration.",
  "strategy": [
    "Use simple plant automata: one for sensor outcomes and one for motion command capability.",
    "Use one specification per perception-to-action binding so each reached condition enables exactly one controllable action.",
    "Bias clear sensing to move_forward rather than random_walk to maximize steady coverage progress.",
    "Handle obstacle_front with a dedicated move_backward recovery, then a directed clockwise turn, then immediate return to exploration when path_clear appears.",
    "Handle obstacle_left with rotate_clockwise and obstacle_right with rotate_counterclockwise for consistent turn-away behavior.",
    "Use full_rotate nowhere in the nominal policy so it remains available in the plant but not selected unless additional specs are later added."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Local perception channel producing uncontrollable obstacle/clear observations.",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion command capability for one-shot open-loop action pulses.",
      "states": [
        "motion"
      ],
      "initial_states": [
        "motion"
      ],
      "marked_states": [
        "motion"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"motion\", \"move_forward\", \"motion\")",
        "(\"motion\", \"rotate_clockwise\", \"motion\")",
        "(\"motion\", \"rotate_counterclockwise\", \"motion\")",
        "(\"motion\", \"full_rotate\", \"motion\")",
        "(\"motion\", \"random_walk\", \"motion\")",
        "(\"motion\", \"move_backward\", \"motion\")"
      ]
    }
  ],

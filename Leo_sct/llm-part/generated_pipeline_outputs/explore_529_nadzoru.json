        "(\"percept_obs_left\", \"path_clear\", \"percept_clear\")",
        "(\"percept_obs_left\", \"obstacle_front\", \"percept_obs_front\")",
        "(\"percept_obs_left\", \"obstacle_left\", \"percept_obs_left\")",
        "(\"percept_obs_left\", \"obstacle_right\", \"percept_obs_right\")",
        "(\"percept_obs_right\", \"path_clear\", \"percept_clear\")",
        "(\"percept_obs_right\", \"obstacle_front\", \"percept_obs_front\")",
        "(\"percept_obs_right\", \"obstacle_left\", \"percept_obs_left\")",
        "(\"percept_obs_right\", \"obstacle_right\", \"percept_obs_right\")"

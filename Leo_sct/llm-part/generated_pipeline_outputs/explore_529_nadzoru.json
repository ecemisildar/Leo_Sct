{
  "rationale": "We separate sensing (perception) and actuation (motion) into distinct plant automata. The main specification binds perception outcomes to safe, progress-oriented actions, ensuring forward exploration dominates when clear, and conservative recovery is used only as needed. Dedicated helper states handle obstacle recovery, with rare use of move_backward and full_rotate, as required by the constraints.",
  "strategy": [
    "Model perception as a plant automaton with uncontrollable obstacle events and path_clear.",
    "Model motion as a plant automaton with controllable actions; use the specification to enforce safe, coverage-oriented exploration and conservative recovery."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Perception plant: models robot's local environment sensing (front, left, right obstacles and clear path).",
      "states": [
        "percept_clear",
        "percept_obs_front",
        "percept_obs_left",
        "percept_obs_right"
      ],
      "initial_states": [
        "percept_clear"
      ],
      "marked_states": [
        "percept_clear",
        "percept_obs_front",
        "percept_obs_left",
        "percept_obs_right"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"percept_clear\", \"obstacle_front\", \"percept_obs_front\")",

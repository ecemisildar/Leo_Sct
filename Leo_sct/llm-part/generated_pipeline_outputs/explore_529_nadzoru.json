    {
      "name": "G2",
      "purpose": "Motion plant: models robot's ability to execute motion commands as open-loop pulses.",
      "states": [
        "idle",
        "forward_commit",
        "random_walk_commit",
        "rotate_commit_cw",
        "rotate_commit_ccw",
        "recover_back",
        "after_back_turn_cw",
        "after_back_turn_ccw",
        "full_rotate_commit"

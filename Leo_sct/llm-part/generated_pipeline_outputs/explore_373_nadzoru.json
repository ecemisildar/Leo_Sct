        "(\"percept\", \"obstacle_front\", \"percept\")",
        "(\"percept\", \"obstacle_left\", \"percept\")",
        "(\"percept\", \"obstacle_right\", \"percept\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion plant: models robot's ability to execute motion commands.",

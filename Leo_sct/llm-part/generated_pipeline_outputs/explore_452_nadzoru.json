{
  "rationale": "Use a minimal plant split into sensing and motion capability, then encode the exploration policy in small deterministic specifications. The policy gives strong forward bias in clear space, uses one-shot directed recovery after obstacle events, keeps uncontrollable sensing total in every spec state, and treats action states as commit states where path_clear self-loops while safety-critical obstacle events can redirect recovery.",
  "strategy": [
    "Separate sensor outcomes from motion capabilities in G so E can impose safe exploration logic cleanly.",
    "Use clear->forward, front->back then turn, left->clockwise, right->counterclockwise, and return to forward exploration immediately on path_clear."
  ],
  "G": [
    {
      "name": "G1",
      "purpose": "Local perception channel producing obstacle and clear observations",
      "states": [
        "sense"
      ],
      "initial_states": [
        "sense"
      ],
      "marked_states": [
        "sense"
      ],
      "controllable_events": [],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"sense\", \"path_clear\", \"sense\")",
        "(\"sense\", \"obstacle_front\", \"sense\")",
        "(\"sense\", \"obstacle_left\", \"sense\")",
        "(\"sense\", \"obstacle_right\", \"sense\")"
      ]
    },
    {
      "name": "G2",
      "purpose": "Motion capability plant for all available robot commands",
      "states": [
        "ready"
      ],
      "initial_states": [
        "ready"
      ],
      "marked_states": [
        "ready"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "full_rotate",
        "random_walk",
        "move_backward"
      ],
      "uncontrollable_events": [],
      "transitions": [
        "(\"ready\", \"move_forward\", \"ready\")",
        "(\"ready\", \"rotate_clockwise\", \"ready\")",
        "(\"ready\", \"rotate_counterclockwise\", \"ready\")",
        "(\"ready\", \"full_rotate\", \"ready\")",
        "(\"ready\", \"random_walk\", \"ready\")",
        "(\"ready\", \"move_backward\", \"ready\")"
      ]
    }
  ],
  "E": [
    {
      "name": "E1_policy",
      "purpose": "Main exploration and obstacle-recovery policy",
      "states": [
        "monitor",
        "clear_go",
        "front_back",
        "front_turn_cw",
        "left_turn_cw",
        "right_turn_ccw"
      ],
      "initial_states": [
        "monitor"
      ],
      "marked_states": [
        "monitor",
        "clear_go",
        "front_back",
        "front_turn_cw",
        "left_turn_cw",
        "right_turn_ccw"
      ],
      "controllable_events": [
        "move_forward",
        "rotate_clockwise",
        "rotate_counterclockwise",
        "move_backward"
      ],
      "uncontrollable_events": [
        "path_clear",
        "obstacle_front",
        "obstacle_left",
        "obstacle_right"
      ],
      "transitions": [
        "(\"monitor\", \"path_clear\", \"clear_go\")",
        "(\"monitor\", \"obstacle_front\", \"front_back\")",
        "(\"monitor\", \"obstacle_left\", \"left_turn_cw\")",
        "(\"monitor\", \"obstacle_right\", \"right_turn_ccw\")",
        "(\"clear_go\", \"move_forward\", \"monitor\")",
        "(\"clear_go\", \"path_clear\", \"clear_go\")",
        "(\"clear_go\", \"obstacle_front\", \"front_back\")",
        "(\"clear_go\", \"obstacle_left\", \"left_turn_cw\")",
        "(\"clear_go\", \"obstacle_right\", \"right_turn_ccw\")",
        "(\"front_back\", \"move_backward\", \"front_turn_cw\")",
        "(\"front_back\", \"path_clear\", \"front_back\")",
        "(\"front_back\", \"obstacle_front\", \"front_back\")",
        "(\"front_back\", \"obstacle_left\", \"left_turn_cw\")",
        "(\"front_back\", \"obstacle_right\", \"right_turn_ccw\")",
        "(\"front_turn_cw\", \"rotate_clockwise\", \"monitor\")",
        "(\"front_turn_cw\", \"path_clear\", \"front_turn_cw\")",
        "(\"front_turn_cw\", \"obstacle_front\", \"front_turn_cw\")",
        "(\"front_turn_cw\", \"obstacle_left\", \"left_turn_cw\")",
        "(\"front_turn_cw\", \"obstacle_right\", \"right_turn_ccw\")",
        "(\"left_turn_cw\", \"rotate_clockwise\", \"monitor\")",
        "(\"left_turn_cw\", \"path_clear\", \"left_turn_cw\")",
        "(\"left_turn_cw\", \"obstacle_front\", \"front_back\")",
        "(\"left_turn_cw\", \"obstacle_left\", \"left_turn_cw\")",
        "(\"left_turn_cw\", \"obstacle_right\", \"right_turn_ccw\")",
        "(\"right_turn_ccw\", \"rotate_counterclockwise\", \"monitor\")",

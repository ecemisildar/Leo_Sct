E2: defines that a leader robot can send an offer to a follower
when it receives a corresponding broadcast message. Alternatively, it can choose to ignore the request.

<?xml version='1.0' encoding='utf-8'?>
<model version="0.0" type="FSA" id="Sup_reactive_motion">
  <data>
    <state id="0" name="q1" initial="True" marked="True" x="150" y="200" />
    <state id="1" name="q2" initial="False" marked="True" x="350" y="200" />
    <state id="2" name="q3" initial="False" marked="True" x="150" y="200" />
    <state id="3" name="q4" initial="False" marked="True" x="150" y="200" />

    <event id="0" name="setLeader" controllable="False" observable="True" />
    <event id="1" name="receiveBB" controllable="False" observable="True" />
    <event id="2" name="receiveBG" controllable="False" observable="True" />
    <event id="3" name="sendOG" controllable="True" observable="True" />
    <event id="4" name="sendOB" controllable="True" observable="True" />
    <event id="5" name="ignoreOG" controllable="True" observable="True" />
    <event id="6" name="ignoreOB" controllable="True" observable="True" />


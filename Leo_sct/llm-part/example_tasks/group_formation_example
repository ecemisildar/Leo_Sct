  <data>
    <state id="0" name="q1" initial="True" marked="True" x="150" y="200" />
    <state id="1" name="q2" initial="False" marked="True" x="350" y="200" />
    <state id="2" name="q3" initial="False" marked="True" x="150" y="200" />
    <state id="3" name="q4" initial="False" marked="True" x="150" y="200" />
    <state id="4" name="q5" initial="False" marked="True" x="350" y="200" />
    <state id="5" name="q6" initial="False" marked="True" x="150" y="200" />
    <state id="6" name="q7" initial="False" marked="True" x="150" y="200" />

    <event id="0" name="join" controllable="True" observable="True" />
    <event id="1" name="setGreen" controllable="False" observable="True" />
    <event id="2" name="setBlue" controllable="False" observable="True" />
    <event id="3" name="receiveOB" controllable="False" observable="True" />
    <event id="4" name="receiveOG" controllable="False" observable="True" />
    <event id="5" name="sendAB" controllable="True" observable="True" />
    <event id="6" name="sendBB" controllable="True" observable="True" />
    <event id="7" name="sendAG" controllable="True" observable="True" />
    <event id="8" name="sendBG" controllable="True" observable="True" />
    <event id="9" name="sendE" controllable="True" observable="True" />

    <transition source="0" target="0" event="3" />
    <transition source="0" target="0" event="4" />
    <transition source="0" target="1" event="1" />
    <transition source="0" target="2" event="2" />
    <transition source="1" target="1" event="3" />
    <transition source="1" target="1" event="8" />
    <transition source="2" target="2" event="4" />
    <transition source="2" target="2" event="6" />
    <transition source="2" target="4" event="3" />

    <transition source="1" target="3" event="4" />
    <transition source="2" target="4" event="3" />
    <transition source="4" target="5" event="5" />
    <transition source="4" target="5" event="7" />

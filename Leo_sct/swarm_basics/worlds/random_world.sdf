    <model name="top_view_camera">
      <static>true</static>
      <pose>0 0 12 0 1.57079632679 0</pose>
      <link name="link">
        <sensor name="top_view_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>top_view_camera/image</topic>
          <camera>
            <horizontal_fov>1.35</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

